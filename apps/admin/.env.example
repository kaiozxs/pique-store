# O painel usa o MESMO banco e o MESMO projeto Supabase da loja.

# Banco (Supabase): URL do POOLER, porta 6543 ("Transaction pooler")
DATABASE_URL=postgresql://postgres.<projeto>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Login (Supabase Auth) — o mesmo da loja, para a sessão valer nos dois
NEXT_PUBLIC_SUPABASE_URL=https://<projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<chave anon / publishable>

# Envio de fotos de produto (Supabase Storage, bucket público "produtos").
# Chave de SERVIÇO: só no servidor, nunca em variável NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Endereço público da loja: o QR das etiquetas leva à página Verifique seu PIQUE
STOREFRONT_URL=https://pique-store-seven.vercel.app
