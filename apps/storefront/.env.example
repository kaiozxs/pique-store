# Banco (Supabase): use a URL do POOLER, porta 6543 ("Transaction pooler")
DATABASE_URL=postgresql://postgres.<projeto>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Login (Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=https://<projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<chave anon / publishable>

# Endereço público da loja (usado no retorno do Google e no aviso do Mercado Pago)
NEXT_PUBLIC_SITE_URL=https://pique-store-seven.vercel.app

# Mercado Pago
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=<chave pública>
MERCADOPAGO_ACCESS_TOKEN=<access token — só no servidor>
MERCADOPAGO_WEBHOOK_SECRET=<segredo do webhook, opcional>

# Painel (aplicativo separado servido sob /admin)
ADMIN_APP_URL=https://<painel>.vercel.app

# Rotina diária que libera estoque de pedidos abandonados (a Vercel envia este segredo ao chamar o cron)
CRON_SECRET=<texto longo e aleatório>

# reCAPTCHA v2 ("Não sou um robô") no cadastro — chaves em https://www.google.com/recaptcha/admin
# Sem as duas, o cadastro funciona sem a caixa.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<chave do site>
RECAPTCHA_SECRET_KEY=<chave secreta — só no servidor>
